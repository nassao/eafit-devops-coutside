{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "courtside-demo",
        "labels": {
          "pod-security.kubernetes.io/enforce": "restricted",
          "pod-security.kubernetes.io/audit": "restricted",
          "pod-security.kubernetes.io/warn": "restricted",
          "pod-security.kubernetes.io/enforce-version": "v1.36",
          "pod-security.kubernetes.io/audit-version": "v1.36",
          "pod-security.kubernetes.io/warn-version": "v1.36"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "courtside-ci",
        "labels": {
          "pod-security.kubernetes.io/enforce": "restricted",
          "pod-security.kubernetes.io/audit": "restricted",
          "pod-security.kubernetes.io/warn": "restricted",
          "pod-security.kubernetes.io/enforce-version": "v1.36",
          "pod-security.kubernetes.io/audit-version": "v1.36",
          "pod-security.kubernetes.io/warn-version": "v1.36"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "courtside-deployer",
        "namespace": "courtside-ci"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "courtside-app",
        "namespace": "courtside-demo"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "default",
        "namespace": "courtside-demo"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "courtside-budget",
        "namespace": "courtside-demo"
      },
      "spec": {
        "hard": {
          "requests.cpu": "2",
          "requests.memory": "2Gi",
          "limits.cpu": "3",
          "limits.memory": "3Gi",
          "pods": "8",
          "services": "6",
          "services.nodeports": "0",
          "services.loadbalancers": "0",
          "persistentvolumeclaims": "2",
          "requests.storage": "1Gi"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "LimitRange",
      "metadata": {
        "name": "courtside-defaults",
        "namespace": "courtside-demo"
      },
      "spec": {
        "limits": [
          {
            "type": "Container",
            "defaultRequest": {
              "cpu": "100m",
              "memory": "128Mi"
            },
            "default": {
              "cpu": "500m",
              "memory": "256Mi"
            },
            "max": {
              "cpu": "1",
              "memory": "1Gi"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "courtside-deployer",
        "namespace": "courtside-demo"
      },
      "rules": [
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "update",
            "patch",
            "delete"
          ]
        },
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "replicasets"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods",
            "events"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods/log"
          ],
          "verbs": [
            "get"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "configmaps"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "update",
            "patch",
            "delete"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "courtside-deployer",
        "namespace": "courtside-demo"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "courtside-deployer"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "courtside-deployer",
          "namespace": "courtside-ci"
        }
      ]
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "default-deny",
        "namespace": "courtside-demo"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "allow-dns",
        "namespace": "courtside-demo"
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "UDP",
                "port": 53
              },
              {
                "protocol": "TCP",
                "port": 53
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "allow-postgres",
        "namespace": "courtside-demo"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "courtside.io/database-access": "true"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "10.89.0.2/32"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 5432
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "courtside-demo"
      },
      "spec": {
        "ports": [
          {
            "name": "postgres",
            "port": 5432,
            "targetPort": 5432,
            "protocol": "TCP"
          }
        ]
      }
    },
    {
      "apiVersion": "discovery.k8s.io/v1",
      "kind": "EndpointSlice",
      "metadata": {
        "name": "postgres",
        "namespace": "courtside-demo",
        "labels": {
          "kubernetes.io/service-name": "postgres",
          "endpointslice.kubernetes.io/managed-by": "courtside-admin"
        }
      },
      "addressType": "IPv4",
      "ports": [
        {
          "name": "postgres",
          "protocol": "TCP",
          "port": 5432
        }
      ],
      "endpoints": [
        {
          "addresses": [
            "10.89.0.2"
          ],
          "conditions": {
            "ready": true
          }
        }
      ]
    }
  ]
}